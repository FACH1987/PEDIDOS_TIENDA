PORT=3000

# En producción debe ser true. Nunca guardes este archivo con contraseñas reales.
DB_ENABLED=false
DB_SERVER=localhost\SQLEXPRESS
DB_PORT=1433
DB_DATABASE=PedidosTiendas
DB_USER=pedidos_app
DB_PASSWORD=
DB_ENCRYPT=true
# En producción debe ser false y SQL Server debe usar un certificado válido.
DB_TRUST_SERVER_CERTIFICATE=false

# Ajusta estos nombres a las tablas reales de tu base de datos.
PRODUCTS_TABLE=app.Productos
ORDERS_TABLE=app.Pedidos
ORDER_LINES_TABLE=app.DetallePedidos